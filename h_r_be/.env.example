# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Server
HOST=127.0.0.1
PORT=8010

# Database
DB_NAME=db.sqlite3

# CORS / CSRF - dev default allows everything; for production set
# CORS_ALLOW_ALL_ORIGINS=False and list your real frontend URL(s) below.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com,https://your-backend.onrender.com

# Backup
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Email OTP (Gmail SMTP) - use a Gmail "app password", not your real password:
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com

# Phone OTP (Twilio) - from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend URL (used to build links in emails, e.g. password reset)
FRONTEND_URL=http://localhost:5176
